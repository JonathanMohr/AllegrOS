# Definiere Variablen
ASM = nasm
CC = gcc
CC16=wcc
LD16=wlink

SRC_DIR = src
BUILD_DIR = build

.PHONY: all os_image bootloader kernel clean always

all: bootloader kernel os_image

#
# OS image
#
os_image: $(BUILD_DIR)/os.img

$(BUILD_DIR)/os.img: bootloader kernel
	fsutil file createnew $(BUILD_DIR)/os.img 1474560
	mformat -i $(BUILD_DIR)/os.img -f 1440 -v "MYOS" -B $(BUILD_DIR)/stage1.bin ::
	mcopy -i $(BUILD_DIR)/os.img $(BUILD_DIR)/stage2.bin "::/stage2.bin"
	mcopy -i $(BUILD_DIR)/os.img $(BUILD_DIR)/kernel.bin "::/kernel.bin"
	mcopy -i $(BUILD_DIR)/os.img test.txt "::/test.txt"

#
# Bootloader
#
bootloader: stage1 stage2

stage1: $(BUILD_DIR)/stage1.bin

$(BUILD_DIR)/stage1.bin: always
	$(MAKE) -C $(SRC_DIR)/bootloader/stage1 BUILD_DIR=$(abspath $(BUILD_DIR))

stage2: $(BUILD_DIR)/stage2.bin

$(BUILD_DIR)/stage2.bin: always
	$(MAKE) -C $(SRC_DIR)/bootloader/stage2 BUILD_DIR=$(abspath $(BUILD_DIR))

#
# Kernel
#
kernel: $(BUILD_DIR)/kernel.bin

$(BUILD_DIR)/kernel.bin: always
	$(MAKE) -C $(SRC_DIR)/kernel BUILD_DIR=$(abspath $(BUILD_DIR))

#
# Always
#
always:
	$(shell mkdir $(BUILD_DIR))

#
# Clean
#
clean:
	$(MAKE) -C $(SRC_DIR)/kernel BUILD_DIR=$(abspath $(BUILD_DIR)) clean
	del /q $(BUILD_DIR)\*